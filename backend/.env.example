# Server Configuration
PORT=3000
NODE_ENV=production

# Option 1: PostgreSQL Connection String (Managed DBs / Render / Neon / Railway)
# DATABASE_URL=postgresql://user:password@host:5432/fastderash
# DATABASE_SSL=true

# Option 2: Standard Local / VPS PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fastderash
DB_USER=postgres
DB_PASSWORD=your_secure_db_password

# Connection Pool Settings (tuned for 1GB RAM VPS)
DB_POOL_MAX=10

# JWT Authentication Secret (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_secret_string

# CORS Allowed Origins (optional; comma-separated domains, or omit for *)
# ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# Telegram Bot Token for Password Reset Verification
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Verify.ET Telebirr Automated Verification API Key
VERIFY_ET_API_KEY=your_verify_et_api_key
